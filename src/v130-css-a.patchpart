diff --git a/src/styles.css b/src/styles.css
index f00697c..36133fe 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -1,3 +1,40 @@
+@font-face {
+  font-family: "Plus Jakarta Sans";
+  src: url("fonts/plus-jakarta-sans.woff2") format("woff2");
+  font-weight: 200 800;
+  font-display: swap;
+}
+@font-face {
+  font-family: "Sora";
+  src: url("fonts/sora.woff2") format("woff2");
+  font-weight: 200 800;
+  font-display: swap;
+}
+@font-face {
+  font-family: "Outfit";
+  src: url("fonts/outfit.woff2") format("woff2");
+  font-weight: 200 800;
+  font-display: swap;
+}
+@font-face {
+  font-family: "Space Grotesk";
+  src: url("fonts/space-grotesk.woff2") format("woff2");
+  font-weight: 200 700;
+  font-display: swap;
+}
+@font-face {
+  font-family: "Syne";
+  src: url("fonts/syne.woff2") format("woff2");
+  font-weight: 400 800;
+  font-display: swap;
+}
+@font-face {
+  font-family: "Manrope";
+  src: url("fonts/manrope.woff2") format("woff2");
+  font-weight: 200 800;
+  font-display: swap;
+}
+
 :root {
   --ink: #111827;
   --muted: #6b7280;
@@ -30,6 +67,7 @@
   --live: rgba(248, 250, 252, 0.94);
   --overlay: rgba(17, 24, 39, 0.48);
   --on-accent: #fff;
+  --nav-active-ink: #fff;
   color: var(--ink);
   font-family: "Segoe UI", system-ui, sans-serif;
   font-size: 14px;
@@ -67,122 +105,209 @@ html[data-theme="default"][data-mode="dark"] {
   --live: rgba(12, 17, 27, 0.94);
   --overlay: rgba(0, 0, 0, 0.62);
   --on-accent: #1e1b4b;
+  --nav-active-ink: #fff;
+  color-scheme: dark;
 }
 
