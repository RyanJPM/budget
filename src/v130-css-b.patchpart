+.theme-list { display: flex; flex-direction: column; gap: 8px; max-height: min(62vh, 540px); overflow: auto; }
 .theme-choice {
   display: flex;
   flex-direction: column;
@@ -474,10 +599,12 @@ html:not([data-theme="default"]) #mode-toggle { display: none; }
 .theme-choice.on { border-color: var(--accent); background: var(--soft); }
 .theme-choice strong { color: var(--ink); font-size: 15px; }
 .theme-choice span, .theme-choice em { color: var(--muted); font-size: 12px; font-style: normal; }
-.theme-choice[data-theme="papier"] { font-family: Georgia, "Times New Roman", serif; }
-.theme-choice[data-theme="foret"] { font-family: Verdana, Geneva, sans-serif; }
-.theme-choice[data-theme="ocean"] { font-family: Calibri, Candara, "Segoe UI", sans-serif; }
