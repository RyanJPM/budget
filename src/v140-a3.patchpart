+test("un placement sort du compte et reste visible à part", () => {
+  const data = blankBudget(new Date("2026-10-15T12:00:00Z"));
+  data.salary = 1000;
+  data.floor = 0;
+  data.investments.push({ name: "Livret", amount: 40, start: "2026-11", end: "" });
+  const rows = forecast(data, { y: 2026, m: 10 });
+  const by = Object.fromEntries(rows.map((row) => [row.id, row]));
+  near(by["2026-10"].placed, 0, "pas encore");
+  near(by["2026-10"].pot, 0, "rien de côté");
+  near(by["2026-10"].reste, 1000, "octobre intact");
+  near(by["2026-11"].placed, 40, "novembre");
+  near(by["2026-11"].pot, 40, "pot novembre");
+  near(by["2026-11"].reste, 1960, "le compte baisse, le pot non");
+  near(by["2026-12"].pot, 80, "pot décembre");
+});
+
+test("un prêt entre le mois reçu et se rembourse ensuite", () => {
+  const data = blankBudget(new Date("2026-10-15T12:00:00Z"));
+  data.salary = 1000;
+  data.floor = 0;
+  data.loans.push({
+    label: "Banque",
+    amount: 240,
+    received: "2026-11",
+    paid: 0,
+    cap: 80,
+    mode: "Progressif",
+    start: "2026-12",
+  });
+  const rows = forecast(data, { y: 2026, m: 10 });
+  const by = Object.fromEntries(rows.map((row) => [row.id, row]));
+  near(by["2026-10"].borrowed, 0, "pas encore reçu");
+  near(by["2026-10"].encore, 0, "rien dû avant");
+  near(by["2026-11"].borrowed, 240, "reçu");
+  near(by["2026-11"].reste, 1000 + 1000 + 240, "sur le compte");
+  near(by["2026-11"].encore, 240, "à rembourser");
+  near(by["2026-11"].cashPaid, 0, "pas ce mois");
+  near(by["2026-12"].cashPaid, 80, "premier remboursement");
+  near(by["2026-12"].encore, 160, "reste dû");
+  assert.equal(by["2026-12"].debts[0].loan, true);
+});
+
+test("un placement passe avant le remboursement", () => {
+  const data = blankBudget(new Date("2026-10-15T12:00:00Z"));
+  data.salary = 200;
+  data.floor = 150;
+  data.investments.push({ name: "Livret", amount: 80, start: "", end: "" });
+  data.debts.push({ person: "Ami", amount: 100, paid: 0, cap: null, mode: "Progressif" });
+  const row = forecast(data, { y: 2026, m: 10 })[0];
+  near(row.placed, 80, "placé");
