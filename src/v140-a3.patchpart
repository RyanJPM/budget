+.help { margin: 0 0 14px; color: var(--muted); line-height: 1.45; }
 
 .fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
 label.field { display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: var(--muted); }
@@ -537,9 +539,46 @@ label.check input { width: 16px; height: 16px; }
   background: var(--white);
   border: 1px solid var(--line);
   border-radius: 16px;
-  padding: 14px;
-  margin-bottom: 12px;
+  padding: 16px;
+  margin-bottom: 16px;
 }
+.tag {
+  display: inline-block;
+  margin-left: 8px;
+  padding: 1px 7px;
+  border-radius: 999px;
+  background: var(--soft);
+  color: var(--accent);
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  vertical-align: 1px;
+}
+.pot { margin: 8px 0 0; color: var(--muted); }
+#side-pot { margin-top: 6px; }
+#findbar {
+  position: fixed;
+  z-index: 40;
+  top: 14px;
+  left: 50%;
+  transform: translateX(-50%);
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  width: min(420px, calc(100% - 24px));
+  padding: 8px;
+  background: var(--white);
+  color: var(--ink);
+  border: 1px solid var(--line);
+  border-radius: 14px;
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
+}
+#findbar[hidden] { display: none; }
+#findbar input { flex: 1; min-width: 0; }
+#find-count { color: var(--muted); font-size: 12px; min-width: 3.2em; text-align: right; font-variant-numeric: tabular-nums; }
+.find-hit { outline: 2px solid #f97316; outline-offset: 1px; }
+::highlight(budget-find) { background-color: #fde047; color: #111; }
+::highlight(budget-find-on) { background-color: #f97316; color: #111; }
 .debt-top, .row-actions { display: flex; justify-content: space-between; gap: 12px; align-items: center; flex-wrap: wrap; }
 .checks { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 12px; }
 .actions { display: flex; gap: 8px; margin-top: 10px; }
@@ -627,7 +666,7 @@ html:not([data-theme="default"]) #mode-toggle { display: none; }
 .modal-actions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; margin-top: 16px; }
 .modal-error { color: var(--rose); font-size: 13px; min-height: 18px; }
 h1.page { margin: 0; font-size: 28px; letter-spacing: -0.03em; }
-.page-head { margin-bottom: 8px; }
+.page-head { margin-bottom: 18px; }
 
 @media (max-width: 1080px) {
   .grid { grid-template-columns: 1fr; }
